<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Group_Chat_Windo"
    android:background="#E0E0E0"
    app:layout_editor_absoluteX="1dp"
    app:layout_editor_absoluteY="1dp"
    android:orientation="vertical"
    android:fillViewport="true">


    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:id="@+id/chat_header">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/group_btn_back"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_centerVertical="true"
                android:background="@drawable/left_arrow_backup_2_svgrepo_com"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:id="@+id/group_logo"
                android:layout_toEndOf="@+id/group_btn_back"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="12dp"
                android:src="@drawable/grp3"/>

            <TextView
                android:id="@+id/group_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="7dp"
                android:layout_toEndOf="@+id/group_logo"
                android:text="User name"
                android:maxWidth="155dp"
                android:textStyle="bold"
                android:textSize="22sp"/>



        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group_chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/chat_header"
        android:background="@drawable/background_chat_light"
        android:padding="5dp"
        android:layout_above="@+id/txt_message_group"/>




    <EditText
        android:layout_alignParentBottom="true"


        android:id="@+id/txt_message_group"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:textColor="#000000"
        android:layout_marginHorizontal="15dp"
        android:inputType="textMultiLine"
        android:background="@drawable/group_name"
        android:paddingStart="5dp"
        android:paddingEnd="8dp"
        android:textColorHint="#7C7B7B"
        android:hint="Enter message here..."
        android:textSize="19sp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:backgroundTint="#0D8F80"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/txt_message_group"
        app:cardCornerRadius="5dp">
        <ImageButton
            android:id="@+id/btn_send_group"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/gui_email_send_svgrepo_com"
            />
    </androidx.cardview.widget.CardView>


</RelativeLayout>

