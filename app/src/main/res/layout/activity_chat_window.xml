<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Chat_Window_Act"
    android:background="#E0E0E0"
    app:layout_editor_absoluteX="1dp"
    app:layout_editor_absoluteY="1dp"
    android:orientation="vertical"
    android:fillViewport="true">


    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:id="@+id/chat_header">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_centerVertical="true"
                android:background="@drawable/left_arrow_backup_2_svgrepo_com"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/chat_header_image"
                android:layout_width="43dp"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@+id/btn_back"
                android:layout_centerVertical="true"
                android:layout_height="43dp"
                android:src="@drawable/users"/>
            <TextView
                android:id="@+id/chat_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="7dp"
                android:layout_toEndOf="@+id/chat_header_image"
                android:text="User name"
                android:maxWidth="155dp"
                android:textStyle="bold"
                android:textSize="22sp"/>

            <com.zegocloud.uikit.prebuilt.call.invite.widget.ZegoSendCallInvitationButton
                android:id="@+id/chat_call_btn"
                android:layout_marginEnd="25dp"
                android:layout_width="40dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/chat_video_btn"
                android:layout_height="40dp"
                android:background="@drawable/phone_call_1_svgrepo_com" />
            <com.zegocloud.uikit.prebuilt.call.invite.widget.ZegoSendCallInvitationButton
                android:id="@+id/chat_video_btn"
                android:layout_marginEnd="33dp"
                android:layout_width="38dp"
                android:layout_centerVertical="true"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical"
                android:background="@drawable/video_chat" />

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chats_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/chat_header"
        android:background="@drawable/background_chat_light"
        android:padding="5dp"
        android:layout_above="@+id/txt_message_chat"/>




    <EditText
        android:layout_alignParentBottom="true"


        android:id="@+id/txt_message_chat"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:textColor="#000000"
        android:layout_marginHorizontal="15dp"
        android:inputType="textMultiLine"
        android:background="@drawable/group_name"
        android:paddingStart="8dp"
        android:paddingEnd="7dp"
        android:textColorHint="#7C7B7B"
        android:hint="Enter message here..."
        android:textSize="19sp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:backgroundTint="#0D8F80"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/txt_message_chat"
        android:layout_marginStart="5dp"
        app:cardCornerRadius="5dp">
        <ImageButton
            android:id="@+id/btn_send_chat"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/gui_email_send_svgrepo_com"
            />
    </androidx.cardview.widget.CardView>


</RelativeLayout>

