<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_alignParentRight="true"
        android:id="@+id/sender_circular_img"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/add_camera_photo"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="12dp"/>
    <LinearLayout
        android:layout_toLeftOf="@+id/sender_circular_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="8dp"
        android:background="@drawable/sender">
    <TextView
        android:maxWidth="215dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="@drawable/sender"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        android:id="@+id/sender_txt_msg"
        android:padding="9dp"/>
    <TextView
        android:maxWidth="215dp"
        android:layout_below="@+id/sender_txt_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="10sp"
        android:textColor="#000000"
      android:id="@+id/sender_txt_timeStamp"
        android:padding="9dp"/>
    </LinearLayout>




</RelativeLayout>